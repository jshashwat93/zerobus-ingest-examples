# Copy this file to .env and fill in your values, then run ./setup.sh <cli-profile>.
# .env is gitignored. Never commit real credentials.

# ---- Databricks workspace --------------------------------------------------

# Workspace hostname, without https://
#   AWS:   my-workspace.cloud.databricks.com
#   Azure: adb-1234567890123456.12.azuredatabricks.net
#   GCP:   1234567890123456.0.gcp.databricks.com
DATABRICKS_WORKSPACE_URL=my-workspace.cloud.databricks.com

# Service principal OAuth credentials. Leave both blank and setup.sh creates a
# service principal, mints a secret, and writes them back here. Fill them in to
# use one you already have.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Name for the service principal setup.sh creates, if it has to create one.
DATABRICKS_SP_NAME=debezium-zerobus-example

# ---- Derived automatically -------------------------------------------------
# Leave both blank and setup.sh fills them in: the workspace ID comes from the
# workspace itself and the region from your CLI profile. Set them by hand only
# if you are not using the Databricks CLI.

# <workspace-id>.zerobus.<region>.cloud.databricks.com  (.azuredatabricks.net on Azure)
DATABRICKS_INGEST_ENDPOINT=
DATABRICKS_REGION=

# ---- Unity Catalog target --------------------------------------------------
# Required. Name a catalog you can already create a schema in, which is the only
# Unity Catalog permission this needs. It has to be backed by your own cloud
# storage, because Zerobus cannot write to Databricks default storage. To see
# what you have:
#   databricks catalogs list --profile <your-profile>
DATABRICKS_CATALOG=

# setup.sh creates this schema and the two target tables inside the catalog above.
DATABRICKS_SCHEMA=zerobus_cdc

# Only needed if the catalog above does not exist yet and you want setup.sh to
# create it, which does need CREATE CATALOG on the metastore. Give the URL of an
# external location you already have, for example s3://my-bucket/zerobus.
DATABRICKS_CATALOG_STORAGE_ROOT=

# ---- Local SQL Server ------------------------------------------------------
# Throwaway credentials for the demo container. The SA password must satisfy
# SQL Server's policy: 8+ characters from three of upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=Passw0rd!Demo
MSSQL_DATABASE=inventory
DEBEZIUM_SQL_USER=debezium
DEBEZIUM_SQL_PASSWORD=Passw0rd!Dbz

# ---- Load generator --------------------------------------------------------
# Seconds between rounds of inserts, updates and deletes.
LOADGEN_INTERVAL_SECONDS=3
